{
  "name": "mix-it",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "npm run publish:catalog && npm run test:catalog && npm run compile:i18n && vite build",
    "publish:catalog": "node --experimental-strip-types scripts/publish-catalog.ts",
    "preview": "vite preview",
    "compile:i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --emit-ts-declarations --no-emit-git-ignore --no-emit-prettier-ignore",
    "check": "npm run compile:i18n && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:catalog": "vitest run src/lib/catalog/catalog.test.ts",
    "test:e2e": "playwright test",
    "test:all": "npm run test && npm run test:e2e"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.23.1",
    "@playwright/test": "^1.54.0",
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/kit": "^2.37.0",
    "@sveltejs/vite-plugin-svelte": "^6.1.0",
    "svelte": "^5.38.0",
    "svelte-check": "^4.3.0",
    "typescript": "^5.8.3",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@anyblades/blades": "^2.4.9",
    "zod": "^4.0.17"
  }
}
